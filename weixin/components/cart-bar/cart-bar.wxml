<view class="cart-bar flex-row">
  <view class="cart-left flex-row" bind:tap="onCartTap">
    <view class="cart-icon-wrap {{totalCount > 0 ? 'has-item' : ''}}">
      <view class="cart-icon">🛒</view>
      <view class="cart-badge" wx:if="{{totalCount > 0}}">{{totalCount > 99 ? '99+' : totalCount}}</view>
    </view>
    <view class="cart-price">
      <text class="price" wx:if="{{totalAmount > 0}}">{{totalAmount}}</text>
      <text class="cart-empty-text" wx:else>未选购商品</text>
    </view>
  </view>
  <view class="cart-btn {{totalCount > 0 && shopStatus === 1 ? '' : 'disabled'}}" bind:tap="onCheckout">
    去结算
  </view>
</view>
