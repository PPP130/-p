page {
  --primary: #FFC107;
  --primary-dark: #FFA000;
  --text: #333;
  --text-light: #999;
  --text-lighter: #ccc;
  --bg: #f5f5f5;
  --bg-white: #fff;
  --border: #eee;
  --danger: #e74c3c;
  --success: #27ae60;
  --price: #e74c3c;

  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  color: var(--price);
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 24rpx;
}

.btn-primary {
  background: var(--primary);
  color: #333;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-primary::after {
  border: none;
}

.empty-tip {
  text-align: center;
  color: var(--text-light);
  padding: 100rpx 0;
  font-size: 28rpx;
}
