page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.user-section {
  background: linear-gradient(135deg, #FFC107, #FFA000);
  padding: 60rpx 40rpx 40rpx;
}

.user-info {
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
}

.user-detail {
  color: #333;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

.order-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-header {
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
}

.section-link {
  font-size: 26rpx;
  color: var(--text-light);
}

.order-shortcuts {
  justify-content: space-around;
}

.shortcut-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.shortcut-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.shortcut-label {
  font-size: 24rpx;
  color: var(--text);
}

.shortcut-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  padding: 0 6rpx;
}

.menu-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
}

.menu-item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.menu-label {
  font-size: 28rpx;
  color: var(--text);
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--text-lighter);
}

.shop-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.shop-info-row {
  align-items: center;
}

.shop-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.shop-detail {
  display: flex;
  flex-direction: column;
}

.shop-current-label {
  font-size: 22rpx;
  color: var(--text-light);
  margin-bottom: 4rpx;
}

.shop-current-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text);
}

.switch-btn {
  font-size: 24rpx;
  color: #FFC107;
  border: 1rpx solid #FFC107;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}
