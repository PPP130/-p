page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

.page-header {
  background: #FFC107;
  padding: 60rpx 32rpx 24rpx;
  text-align: center;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.loading-wrap,
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light);
}

.shop-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

.shop-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.shop-card.shop-closed {
  opacity: 0.6;
}

.shop-image {
  width: 100%;
  height: 300rpx;
}

.shop-image-placeholder {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #FFC107 0%, #FFB300 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: bold;
}

.shop-info {
  padding: 24rpx;
}

.shop-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.status-open {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-closed {
  background: #fff3e0;
  color: #e65100;
}

.shop-address {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 8rpx;
}

.address-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.shop-desc {
  font-size: 24rpx;
  color: var(--text-light);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
