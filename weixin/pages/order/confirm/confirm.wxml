<navigation-bar title="确认订单" back="{{true}}" color="black" background="#fff"></navigation-bar>

<view class="page-container">
  <scroll-view class="order-scroll" scroll-y>
    <!-- 收货地址 -->
    <view class="address-card" bind:tap="onSelectAddress">
      <view wx:if="{{address}}" class="address-info">
        <view class="address-top flex-row">
          <text class="address-name">{{address.consignee}}</text>
          <text class="address-phone">{{address.phone}}</text>
          <text class="address-tag" wx:if="{{address.label}}">{{address.label}}</text>
        </view>
        <view class="address-detail">{{address.provinceName}}{{address.cityName}}{{address.districtName}}{{address.detail}}</view>
      </view>
      <view wx:else class="address-empty">
        <text>请选择收货地址</text>
      </view>
      <text class="address-arrow">›</text>
    </view>

    <!-- 商品列表 -->
    <view class="section">
      <view class="section-title">商品信息</view>
      <view class="goods-item flex-row" wx:for="{{cartItems}}" wx:key="id">
        <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-info flex-1">
          <view class="goods-name text-ellipsis">{{item.name}}</view>
          <view class="goods-flavor" wx:if="{{item.dishFlavor}}">{{item.dishFlavor}}</view>
          <view class="goods-bottom flex-row">
            <view class="goods-price price">{{item.amount}}</view>
            <text class="goods-number">x{{item.number}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 餐具数量 -->
    <view class="section">
      <view class="section-row flex-row">
        <text class="row-label">餐具数量</text>
        <input class="row-input" type="number" value="{{tablewareNumber}}" bind:change="onTablewareChange" />
      </view>
    </view>

    <!-- 备注 -->
    <view class="section">
      <view class="section-row flex-row">
        <text class="row-label">订单备注</text>
        <input class="row-input" placeholder="请输入备注" value="{{remark}}" bind:input="onRemarkInput" />
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="section">
      <view class="section-row flex-row">
        <text class="row-label">菜品总价</text>
        <text class="price">{{totalAmount}}</text>
      </view>
      <view class="section-row flex-row">
        <text class="row-label">打包费</text>
        <text class="price">{{packAmount}}</text>
      </view>
      <view class="section-row flex-row total-row">
        <text class="row-label">合计</text>
        <text class="price total-price">{{totalAmount + packAmount}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部提交栏 -->
  <view class="submit-bar flex-row">
    <view class="submit-info">
      <text class="submit-label">实付：</text>
      <text class="submit-price price">{{totalAmount + packAmount}}</text>
    </view>
    <view class="submit-btn btn-primary" bind:tap="onSubmit">提交订单</view>
  </view>
</view>
