page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.order-scroll {
  flex: 1;
  padding-bottom: 120rpx;
}

.address-card {
  background: #fff;
  padding: 24rpx;
  margin: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.address-info {
  flex: 1;
}

.address-top {
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 28rpx;
  color: var(--text-light);
  margin-right: 16rpx;
}

.address-tag {
  font-size: 22rpx;
  color: var(--primary-dark);
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-light);
}

.address-empty {
  flex: 1;
  color: var(--text-light);
  font-size: 28rpx;
}

.address-arrow {
  font-size: 36rpx;
  color: var(--text-lighter);
  margin-left: 16rpx;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.goods-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.goods-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  font-weight: bold;
}

.goods-flavor {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.goods-bottom {
  justify-content: space-between;
}

.goods-price {
  font-size: 30rpx;
}

.goods-number {
  font-size: 26rpx;
  color: var(--text-light);
}

.section-row {
  justify-content: space-between;
  padding: 16rpx 0;
}

.row-label {
  font-size: 28rpx;
  color: var(--text);
}

.row-input {
  text-align: right;
  font-size: 28rpx;
  flex: 1;
  margin-left: 20rpx;
}

.total-row {
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
  margin-top: 8rpx;
}

.total-price {
  font-size: 36rpx;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
  padding: 0 24rpx;
  justify-content: space-between;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.submit-info {
  display: flex;
  align-items: center;
}

.submit-label {
  font-size: 28rpx;
}

.submit-price {
  font-size: 40rpx;
}

.submit-price::before {
  font-size: 26rpx;
}

.submit-btn {
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
}
