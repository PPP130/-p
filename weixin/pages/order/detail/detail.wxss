page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-scroll {
  flex: 1;
  padding-bottom: 120rpx;
}

.status-section {
  background: linear-gradient(135deg, #FFC107, #FFA000);
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  color: #333;
}

.status-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.8;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.info-row.total {
  border-top: 1rpx solid var(--border);
  margin-top: 8rpx;
  padding-top: 20rpx;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text);
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.info-value.danger {
  color: var(--danger);
}

.total-price {
  font-size: 36rpx;
}

.total-price::before {
  font-size: 26rpx;
}

.goods-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  align-items: center;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.goods-info {
  margin-left: 16rpx;
  overflow: hidden;
}

.goods-name {
  font-size: 26rpx;
}

.goods-flavor {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.goods-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.goods-price {
  font-size: 26rpx;
}

.goods-price::before {
  font-size: 22rpx;
}

.goods-number {
  font-size: 22rpx;
  color: var(--text-light);
  display: block;
  margin-top: 4rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid var(--border);
  padding: 0 24rpx;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
  gap: 20rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  border: 2rpx solid var(--border);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text);
}

.action-btn.primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #333;
  font-weight: bold;
}
