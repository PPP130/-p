<navigation-bar title="订单详情" back="{{true}}" color="black" background="#fff"></navigation-bar>

<view class="page-container" wx:if="{{order}}">
  <scroll-view class="detail-scroll" scroll-y>
    <!-- 订单状态 -->
    <view class="status-section">
      <view class="status-icon">{{statusInfo.icon}}</view>
      <view class="status-text">{{statusInfo.text}}</view>
      <view class="status-desc" wx:if="{{order.status === 1}}">请尽快完成支付</view>
      <view class="status-desc" wx:if="{{order.status === 2}}">商家正在处理您的订单</view>
      <view class="status-desc" wx:if="{{order.status === 3}}">商家正在准备中</view>
      <view class="status-desc" wx:if="{{order.status === 4}}">骑手正在配送中</view>
    </view>

    <!-- 收货信息 -->
    <view class="section">
      <view class="section-title">收货信息</view>
      <view class="info-row">
        <text class="info-label">收货人</text>
        <text class="info-value">{{order.consignee}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手机号</text>
        <text class="info-value">{{order.phone}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">地址</text>
        <text class="info-value">{{order.address}}</text>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="section">
      <view class="section-title">商品明细</view>
      <view class="goods-item flex-row" wx:for="{{order.orderDetailList}}" wx:key="id">
        <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-info flex-1">
          <text class="goods-name text-ellipsis">{{item.name}}</text>
          <text class="goods-flavor" wx:if="{{item.dishFlavor}}">{{item.dishFlavor}}</text>
        </view>
        <view class="goods-right">
          <text class="goods-price price">{{item.amount}}</text>
          <text class="goods-number">x{{item.number}}</text>
        </view>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="section">
      <view class="section-title">费用明细</view>
      <view class="info-row">
        <text class="info-label">菜品总价</text>
        <text class="price">{{order.amount - (order.packAmount || 0)}}</text>
      </view>
      <view class="info-row" wx:if="{{order.packAmount}}">
        <text class="info-label">打包费</text>
        <text class="price">{{order.packAmount}}</text>
      </view>
      <view class="info-row total">
        <text class="info-label">实付金额</text>
        <text class="price total-price">{{order.amount}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单号</text>
        <text class="info-value">{{order.number}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{order.orderTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
      <view class="info-row" wx:if="{{order.cancelReason}}">
        <text class="info-label">取消原因</text>
        <text class="info-value danger">{{order.cancelReason}}</text>
      </view>
      <view class="info-row" wx:if="{{order.rejectionReason}}">
        <text class="info-label">拒单原因</text>
        <text class="info-value danger">{{order.rejectionReason}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar flex-row">
    <view class="action-btn" wx:if="{{order.status === 4}}" bind:tap="onRemind">催单</view>
    <view class="action-btn" wx:if="{{order.status === 5}}" bind:tap="onRepeat">再来一单</view>
    <view class="action-btn" wx:if="{{order.status === 1}}" bind:tap="onCancel">取消订单</view>
    <view class="action-btn primary" wx:if="{{order.status === 1}}" bind:tap="onPay">去支付</view>
  </view>
</view>
