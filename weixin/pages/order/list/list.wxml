<navigation-bar title="我的订单" back="{{false}}" color="black" background="#fff"></navigation-bar>

<view class="page-container">
  <!-- Tab栏 -->
  <scroll-view class="tabs-scroll" scroll-x>
    <view class="tabs flex-row">
      <view
        class="tab {{activeTab === item.value ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bind:tap="onTabTap"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y bind:scrolltolower="onReachBottom">
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-tip">暂无订单</view>

    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bind:tap="onOrderTap">
      <view class="order-header flex-row">
        <text class="order-number">订单号：{{item.number}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-goods flex-row" wx:for="{{item.orderDetailList}}" wx:for-item="goods" wx:key="id" wx:if="{{index < 3}}">
        <image class="goods-img" src="{{goods.image}}" mode="aspectFill"></image>
        <view class="goods-info flex-1">
          <text class="goods-name text-ellipsis">{{goods.name}}</text>
          <text class="goods-flavor" wx:if="{{goods.dishFlavor}}">{{goods.dishFlavor}}</text>
        </view>
        <view class="goods-right">
          <text class="goods-price price">{{goods.amount}}</text>
          <text class="goods-number">x{{goods.number}}</text>
        </view>
      </view>

      <view class="order-more" wx:if="{{item.orderDetailList.length > 3}}">
        等{{item.orderDetailList.length}}件商品
      </view>

      <view class="order-footer flex-row">
        <text class="order-time">{{item.orderTime}}</text>
        <view class="order-total">
          <text>共{{item.orderDetailList.length}}件 合计：</text>
          <text class="price">{{item.amount}}</text>
        </view>
      </view>

      <view class="order-actions flex-row">
        <view class="order-btn" wx:if="{{item.status === 5}}" data-id="{{item.id}}" catch:tap="onRepeat">再来一单</view>
        <view class="order-btn primary" wx:if="{{item.status === 1}}" data-id="{{item.id}}" data-number="{{item.number}}" catch:tap="onPay">去支付</view>
        <view class="order-btn" wx:if="{{item.status === 1}}" data-id="{{item.id}}" catch:tap="onCancel">取消订单</view>
      </view>
    </view>

    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
    <view class="loading-tip" wx:if="{{!hasMore && orders.length > 0}}">没有更多了</view>
  </scroll-view>
</view>
