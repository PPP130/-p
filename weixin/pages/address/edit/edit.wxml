<navigation-bar title="{{isEdit ? '编辑地址' : '新增地址'}}" back="{{true}}" color="black" background="#fff"></navigation-bar>

<view class="page-container">
  <scroll-view class="form-scroll" scroll-y>
    <!-- 收货人 -->
    <view class="form-item flex-row">
      <text class="form-label">收货人</text>
      <input class="form-input flex-1" placeholder="请输入收货人姓名" value="{{form.consignee}}" data-field="consignee" bind:input="onInput" />
    </view>

    <!-- 手机号 -->
    <view class="form-item flex-row">
      <text class="form-label">手机号</text>
      <input class="form-input flex-1" type="number" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bind:input="onInput" />
    </view>

    <!-- 性别 -->
    <view class="form-item flex-row">
      <text class="form-label">性别</text>
      <view class="sex-wrap flex-row">
        <view class="sex-item {{form.sex === 0 ? 'active' : ''}}" data-sex="{{0}}" bind:tap="onSexChange">先生</view>
        <view class="sex-item {{form.sex === 1 ? 'active' : ''}}" data-sex="{{1}}" bind:tap="onSexChange">女士</view>
      </view>
    </view>

    <!-- 所在地区 -->
    <view class="form-item flex-row">
      <text class="form-label">地区</text>
      <picker mode="region" value="{{region}}" bind:change="onRegionChange">
        <view class="form-input flex-1 {{region.length ? '' : 'placeholder'}}">
          {{region.length ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择地区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-item flex-row">
      <text class="form-label">详细地址</text>
      <input class="form-input flex-1" placeholder="小区/楼栋/门牌号" value="{{form.detail}}" data-field="detail" bind:input="onInput" />
    </view>

    <!-- 标签 -->
    <view class="form-item">
      <text class="form-label">标签</text>
      <view class="label-wrap flex-row">
        <view
          class="label-item {{form.label === item ? 'active' : ''}}"
          wx:for="{{labelOptions}}"
          wx:key="*this"
          data-label="{{item}}"
          bind:tap="onLabelTap"
        >{{item}}</view>
      </view>
    </view>

    <!-- 设为默认 -->
    <view class="form-item flex-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{form.isDefault === 1}}" color="#FFC107" bind:change="onDefaultChange" />
    </view>
  </scroll-view>

  <!-- 保存按钮 -->
  <view class="save-btn-wrap">
    <view class="save-btn btn-primary" bind:tap="onSubmit">保存</view>
  </view>
</view>
