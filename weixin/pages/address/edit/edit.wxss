page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.form-scroll {
  flex: 1;
  padding-bottom: 140rpx;
}

.form-item {
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border);
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: var(--text);
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  font-size: 28rpx;
  text-align: right;
}

.form-input.placeholder {
  color: var(--text-lighter);
}

.sex-wrap {
  margin-left: auto;
  gap: 20rpx;
}

.sex-item {
  padding: 12rpx 32rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text);
}

.sex-item.active {
  border-color: var(--primary);
  background: #FFF8E1;
  color: var(--primary-dark);
}

.label-wrap {
  margin-top: 16rpx;
  gap: 16rpx;
}

.label-item {
  padding: 12rpx 32rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text);
}

.label-item.active {
  border-color: var(--primary);
  background: #FFF8E1;
  color: var(--primary-dark);
}

.save-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.save-btn {
  width: 100%;
}
