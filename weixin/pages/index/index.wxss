page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.shop-closed {
  background: #fff3e0;
  color: #e65100;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.shop-banner {
  width: 100%;
  height: 240rpx;
  display: block;
}

.search-bar {
  padding: 16rpx 24rpx;
  background: #FFC107;
}

.search-input {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-placeholder {
  color: var(--text-light);
  font-size: 26rpx;
}

.type-tabs {
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--border);
}

.type-tab {
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-light);
  position: relative;
}

.type-tab.active {
  color: var(--text);
  font-weight: bold;
}

.type-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary-dark);
  border-radius: 2rpx;
}

.menu-wrap {
  flex: 1;
  overflow: hidden;
}

.category-list {
  width: 180rpx;
  height: 100%;
  background: #f8f8f8;
}

.category-item {
  padding: 28rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text);
  position: relative;
}

.category-item.active {
  background: #fff;
  font-weight: bold;
  color: var(--primary-dark);
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-dark);
  border-radius: 0 3rpx 3rpx 0;
}

.dish-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding-bottom: 120rpx;
}

/* 购物车面板 */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 51;
}

.cart-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 52;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.panel-header {
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.panel-title {
  font-size: 30rpx;
  font-weight: bold;
}

.panel-clean {
  font-size: 26rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
}

.panel-clean-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.panel-list {
  flex: 1;
  padding: 0 32rpx;
  overflow-y: auto;
}

.panel-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
  align-items: center;
}

.panel-item:last-child {
  border-bottom: none;
}

.panel-item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.panel-item-img-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.panel-item-info {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.panel-item-name {
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-item-flavor {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.panel-item-bottom {
  margin-top: 8rpx;
  justify-content: space-between;
  align-items: center;
}

.panel-item-price {
  font-size: 28rpx;
}

.panel-item-action {
  align-items: center;
}

.panel-icon-btn {
  width: 44rpx;
  height: 44rpx;
}

.panel-icon-delete {
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
}

.panel-count {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  padding: 0 8rpx;
}

.nav-right {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 16rpx;
}

.switch-shop-text {
  font-size: 24rpx;
  color: #333;
  background: rgba(255, 255, 255, 0.6);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
